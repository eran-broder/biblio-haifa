{
  "name": "biblio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Haifa library books — CLI + Chrome extension",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "pnpm --filter @biblio/cli start",
    "ext:dev": "pnpm --filter @biblio/extension dev",
    "ext:build": "pnpm --filter @biblio/extension build",
    "typecheck": "pnpm -r --no-bail typecheck",
    "clean": "pnpm -r clean && rimraf node_modules"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "~5.6.3"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
