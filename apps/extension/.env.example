# Copy this file to .env.local and fill in the values from the Google Cloud
# console (OAuth client) and the Chrome Web Store developer dashboard.
# .env.local is gitignored.

# The extension id from chrome://extensions or the Web Store dashboard.
EXTENSION_ID=

# OAuth 2.0 Desktop-app client from console.cloud.google.com.
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=

# Refresh token obtained via the one-time auth dance with scope
#   https://www.googleapis.com/auth/chromewebstore
CWS_REFRESH_TOKEN=
