{
  "name": "@biblio/extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo biblio.zip",
    "zip": "node scripts/zip.mjs",
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "version:major": "node scripts/bump-version.mjs major",
    "publish:upload": "node scripts/publish.mjs upload",
    "publish:submit": "node scripts/publish.mjs submit",
    "publish:submit:testers": "node scripts/publish.mjs submit --trusted-testers",
    "release": "pnpm build && pnpm zip && pnpm publish:upload && pnpm publish:submit",
    "release:testers": "pnpm build && pnpm zip && pnpm publish:upload && pnpm publish:submit:testers"
  },
  "dependencies": {
    "@biblio/core": "workspace:*",
    "@biblio/http-fetch": "workspace:*",
    "@biblio/ui": "workspace:*",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@tailwindcss/vite": "^4.0.0-beta.7",
    "@types/chrome": "^0.0.277",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "chrome-webstore-upload-cli": "^3.5.0",
    "tailwindcss": "^4.0.0-beta.7",
    "vite": "^5.4.11"
  }
}
